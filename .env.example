# 이 파일을 .env.local로 복사해서 사용하세요. (.env*.local은 git에 올라가지 않습니다)
# 실제 기기에서 테스트할 때는 localhost 대신 PC의 IP를 쓰세요. 예: http://192.168.0.10:8080/api/v1
# API 키·비밀값은 여기에 넣지 마세요. EXPO_PUBLIC_ 값은 앱에 그대로 포함됩니다.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# 목 API 사용 여부와 화면 상태 시나리오 (normal | empty | error | offline | slow)
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_MOCK_SCENARIO=normal

# 시연용 버튼(시간 이동 등) 표시 여부. 시연 빌드에서만 true
EXPO_PUBLIC_DEMO=true

# 실제 서버(EXPO_PUBLIC_USE_MOCK=false)로 확인할 때 로그인 화면에 "개발용 로그인" 버튼 표시
# 백엔드를 local 프로필로 실행해야 동작합니다. 같은 키 = 같은 회원
EXPO_PUBLIC_DEV_LOGIN=false
EXPO_PUBLIC_DEV_LOGIN_KEY=me
